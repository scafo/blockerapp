# Copia in .env.local per provare in locale (npm run dev). Su Vercel le stesse chiavi vanno in Settings → Environment Variables.
# Pubbliche (finiscono nel gioco): progetto Supabase → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Segrete (solo server, mai nel gioco):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Indirizzo del sito, per il ritorno da Stripe (in locale http://localhost:5173)
SITE_URL=
